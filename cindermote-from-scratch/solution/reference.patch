+            not isinstance(limits, dict)
+            or set(limits) - {"cpu.max", "memory.max", "memory.swap.max", "pids.max"}
+            or any(
+                not isinstance(value, str) or not 1 <= len(value) <= 128
+                for value in limits.values()
+            )
