+        worker = runtime.get("egress_worker")
+        if (
+            not isinstance(worker, dict)
+            or set(worker)
+            != {
+                "privilege_separated",
+                "protocol_version",
+                "user",
+                "group",
+                "uid",
+                "gid",
+                "no_new_privs",
+                "dumpable",
+                "capabilities_zero",
+            }
