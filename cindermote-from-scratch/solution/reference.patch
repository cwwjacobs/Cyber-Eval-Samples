+            raise ValueError("unexpected receipt schema")
+        if set(receipt) != {
+            "schema_version",
+            "source_date_epoch",
+            "filesystem_uuid",
+            "directory_hash_seed",
+            "rootfs",
+            "browser",
+            "runtime_packages",
+            "build_inputs",
+            "guest_writes",
+            "sources",
+        }:
