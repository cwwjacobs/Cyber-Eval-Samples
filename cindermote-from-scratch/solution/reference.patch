+        if (
+            not isinstance(browser.get("version"), str)
+            or not browser["version"].startswith("Chromium ")
+            or not isinstance(browser.get("binary_sha256"), str)
+            or DIGEST_PATTERN.fullmatch(browser["binary_sha256"]) is None
+        ):
